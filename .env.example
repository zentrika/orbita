# ─── Órbita · variables de entorno ───────────────────────────────────────────
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

APP_ENV=development            # development | production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false            # true en producción (HTTPS)

# MySQL
MYSQL_DATABASE=orbita
MYSQL_USER=orbita
MYSQL_PASSWORD=orbita_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Redis
REDIS_URL=redis://redis:6379/0

# Almacenamiento S3 (MinIO en local)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=orbita
S3_SECRET_KEY=orbita_minio_password
S3_BUCKET=orbita-attachments
S3_REGION=us-east-1
MAX_UPLOAD_MB=25

# Correo (Mailpit en desarrollo: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Órbita <no-reply@orbita.local>
SMTP_TLS=false

# Datos de demostración idempotentes (sólo se cargan con APP_ENV=development)
SEED_DEMO=true

# Frontend
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Imagen de MinIO. minio/minio ya no se publica en Docker Hub; elige una compatible:
#   pgsty/minio@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372  (fork comunitario)
#   cgr.dev/chainguard/minio:latest                                                       (Chainguard)
#   o compila la imagen oficial desde https://github.com/minio/minio
MINIO_IMAGE=pgsty/minio@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372
